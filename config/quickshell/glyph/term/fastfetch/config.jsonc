// glyph: встроенный логотип Fedora, ключи капсом серым, цвета — круглые точки. Цвета — номерами ANSI: kitty в светлой теме
// меняет 0↔15 и 7↔8, и белое на белом не теряется. ~/.config/fastfetch ссылается сюда, пока жив glyph (rice)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "Fedora",
        "padding": { "top": 1, "left": 2, "right": 6 }
    },
    "display": {
        "separator": "",
        "color": { "keys": "37", "title": "97", "output": "97", "separator": "90" },
        "percent": { "color": { "green": "97", "yellow": "97", "red": "31" } }
    },
    "modules": [
        "break",
        { "type": "title", "color": { "user": "1;97", "at": "37", "host": "1;97" } },
        { "type": "separator", "string": "─", "outputColor": "37" },
        { "type": "os", "key": "OS        " },
        { "type": "kernel", "key": "KERNEL    ", "format": "{release}" },
        { "type": "wm", "key": "WM        ", "format": "{pretty-name}" },
        { "type": "shell", "key": "SHELL     " },
        { "type": "terminal", "key": "TERM      ", "format": "{pretty-name}" },
        { "type": "terminalfont", "key": "FONT      " },
        { "type": "uptime", "key": "UPTIME    " },
        { "type": "memory", "key": "MEMORY    " },
        "break",
        { "type": "colors", "symbol": "circle" },
        "break"
    ]
}
